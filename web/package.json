{
  "name": "@laniakea/cosmic-ui",
  "version": "2.0.0",
  "description": "Cosmic UI v2 — glassmorphism frontend for Laniakea Protocol",
  "type": "module",
  "main": "cosmic.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "playwright test --config=../tests/e2e/playwright.config.js",
    "test:ui": "playwright test --ui --config=../tests/e2e/playwright.config.js",
    "lint": "eslint . --ext .js",
    "format": "prettier --write \"**/*.{js,css,html}\""
  },
  "keywords": ["laniakea", "blockchain", "scda", "metaverse", "cosmos", "8d", "hypercube"],
  "author": "Qalam <Qalam@HipHop.dev>",
  "license": "MIT",
  "dependencies": {
    "chart.js": "^4.4.1",
    "gsap": "^3.12.5",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "vite": "^5.0.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "iOS >= 14"
  ]
}
